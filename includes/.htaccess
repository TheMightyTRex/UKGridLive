# Defense-in-depth: PHP files execute rather than serve as source, so this
# folder is not actually at risk of leaking config.php's contents — but
# denying direct access to everything except nothing here costs nothing
# and blocks accidental .txt/.bak backups of config.php from being served.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
